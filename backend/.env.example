# Copy to backend/.env. Values below are placeholders.
# NOTE: the current version uses an in-memory NetworkX graph; the Neo4j settings
# are read by core/config.py but not used by the running pipeline yet.
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

